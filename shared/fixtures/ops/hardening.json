  {
    "name": "integers beyond the structural bound are schema errors",
    "base": null,
    "ops": [
      {
        "op": "create_wardrobe",
        "width": 9007199254740993,
        "height": 2400,
        "depth": 600,
        "compartmentCount": 1
      }
