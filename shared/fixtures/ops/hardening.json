[
  {
    "name": "explicit null optional fields are treated as absent",
    "base": "two",
    "ops": [
      {
        "op": "add_shelf",
        "compartmentId": "cmp_a",
        "y": 1000,
        "id": "shf_2",
        "thickness": null
      },
      {
        "op": "set_material",
        "target": "carcass",
        "material": null,
        "color": {
          "catalogId": "walnut"
        },
        "finish": null
      },
      {
        "op": "configure_doors",
        "type": "hinged",
        "doors": [
          {
            "id": null,
            "compartmentIds": [
              "cmp_a",
              "cmp_b"
            ],
            "hingeSide": "left"
          }
        ],
        "count": null,
        "ids": null
      }
    ],
    "expect": {
      "match": {
        "compartments": [
          {
            "shelves": [
              {},
              {
                "id": "shf_2",
                "thickness": 18
              }
            ]
          },
          {}
        ],
        "carcass": {
          "appearance": {
            "color": {
              "catalogId": "walnut"
            }
          }
        },
        "doors": {
          "type": "hinged",
          "items": [
            {
              "compartmentIds": [
                "cmp_a",
                "cmp_b"
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "configure none with explicit nulls",
    "base": "two",
    "ops": [
      {
        "op": "configure_doors",
        "type": "none",
        "doors": null,
        "count": null,
        "ids": null
      }
    ],
    "expect": {
      "match": {
        "doors": {
          "type": "none",
          "items": []
        }
      }
    }
  },
  {
    "name": "snake_case op keys are rejected",
    "base": "two",
    "ops": [
      {
        "op": "add_shelf",
        "compartment_id": "cmp_a",
        "y": 1000
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "snake_case design keys are rejected",
    "base": "two",
    "mutate": [
      {
        "path": [
          "carcass",
          "panel_thickness"
        ],
        "value": 20
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "carcass.panel_thickness"
      }
    }
  },
  {
    "name": "unknown nested key is reported at the key",
    "base": "two",
    "mutate": [
      {
        "path": [
          "compartments",
          0,
          "shelves",
          0,
          "color"
        ],
        "value": "red"
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "compartments[0].shelves[0].color"
      }
    }
  },
  {
    "name": "unknown top-level key is reported at the key",
    "base": "two",
    "mutate": [
      {
        "path": [
          "foo"
        ],
        "value": 1
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "foo"
      }
    }
  },
