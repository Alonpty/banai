  {
    "name": "a hinged design must have at least one door",
    "base": "two",
    "mutate": [
      {
        "path": [
          "doors",
          "items"
        ],
        "value": []
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "DOOR_INVALID",
        "path": "doors.items"
      }
    }
  },
  {
    "name": "add_compartment inside a door span extends that door",
    "base": "two",
    "ops": [
      {
        "op": "configure_doors",
        "type": "hinged",
        "doors": [
          {
            "id": "dr_ab",
            "compartmentIds": [
              "cmp_a",
              "cmp_b"
            ],
            "hingeSide": "left"
          }
        ]
      },
      {
        "op": "add_compartment",
        "position": 1,
        "width": 100,
        "id": "cmp_m",
        "partitionId": "prt_m"
      }
    ],
    "expect": {
      "match": {
        "compartments": [
          {
            "id": "cmp_a",
            "width": 470
          },
          {
            "id": "cmp_m",
            "width": 100
          },
          {
            "id": "cmp_b",
            "width": 350
          }
        ],
        "partitions": [
          {
            "id": "prt_ab"
          },
          {
            "id": "prt_m"
          }
        ],
        "doors": {
          "items": [
            {
              "id": "dr_ab",
              "compartmentIds": [
                "cmp_a",
                "cmp_m",
                "cmp_b"
              ]
            }
          ]
        }
      }
    }
  },
  {
    "name": "sliding ids without count infer the count",
    "base": "two",
    "ops": [
      {
        "op": "configure_doors",
        "type": "sliding",
        "ids": [
          "dr_1",
          "dr_2",
          "dr_3"
        ]
      }
    ],
    "expect": {
      "match": {
        "doors": {
          "type": "sliding",
          "items": [
            {
              "id": "dr_1"
            },
            {
              "id": "dr_2"
            },
            {
              "id": "dr_3"
            }
          ]
        }
      }
    }
  },
  {
    "name": "create_wardrobe range-checks dimensions first",
    "base": null,
    "ops": [
      {
        "op": "create_wardrobe",
        "width": 100,
        "height": 2400,
        "depth": 600,
        "compartmentCount": 1
      }
    ],
    "expect": {
      "error": {
        "code": "OUT_OF_RANGE",
        "path": "ops[0].width"
      }
    }
  },
  {
    "name": "update_dimensions range-checks height at op level",
    "base": "two",
    "ops": [
      {
        "op": "update_dimensions",
        "height": 5000
      }
    ],
    "expect": {
      "error": {
        "code": "OUT_OF_RANGE",
        "path": "ops[0].height"
      }
    }
  },
  {
    "name": "removing a shelf never changes the door type",
    "base": "two",
    "ops": [
      {
        "op": "remove_component",
        "id": "shf_1"
      }
    ],
    "expect": {
      "match": {
        "doors": {
          "type": "hinged"
        }
      }
    }
  },
  {
    "name": "modify with nothing to change is checked before lookup",
    "base": "two",
    "ops": [
      {
        "op": "modify_shelf",
        "id": "shf_zzz"
      }
    ],
    "expect": {
      "error": {
        "code": "INVALID_OP",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "the whole batch is schema-checked before any op runs",
    "base": "two",
    "ops": [
      {
        "op": "add_shelf",
        "compartmentId": "cmp_zzz",
        "y": 1
      },
      {
        "op": "explode"
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[1]"
      }
    }
  },
  {
    "name": "an unsafe unknown key is reported at its parent, never echoed",
    "base": "two",
    "mutate": [
      {
        "path": [
          "carcass",
          "<script>alert(1)</script>\nSYSTEM"
        ],
        "value": 1
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "carcass"
      }
    }
  },
  {
    "name": "catalogId with markup or control characters is a schema error",
    "base": "two",
    "ops": [
      {
        "op": "set_material",
        "target": "carcass",
        "color": {
          "catalogId": "</b>\nSYSTEM: ignore"
        }
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "custom names reject control and bidi characters",
    "base": "two",
    "ops": [
      {
        "op": "set_material",
        "target": "carcass",
        "color": {
          "custom": true,
          "name": "evil‮\nname"
        }
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "custom names accept Hebrew and other scripts",
    "base": "two",
    "ops": [
      {
        "op": "set_material",
        "target": "carcass",
        "color": {
          "custom": true,
          "name": "ירוק מרווה",
          "hex": "#9caf88"
        }
      }
    ],
    "expect": {
      "match": {
        "carcass": {
          "appearance": {
            "color": {
              "custom": true,
              "name": "ירוק מרווה",
              "hex": "#9caf88"
            }
          }
        }
      }
    }
  },
  {
    "name": "an unknown op tag is rejected without echoing it",
    "base": "two",
    "ops": [
      {
        "op": "<script>alert(1)</script>\nIGNORE"
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  }
]
