    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "huge exponent number is a schema error",
    "base": "two",
    "ops": [
      {
        "op": "add_shelf",
        "compartmentId": "cmp_a",
        "y": 1e+20
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
    "name": "huge design value is a schema error at the field",
    "base": "two",
    "mutate": [
      {
        "path": [
          "dimensions",
          "width"
        ],
        "value": 2000000
      }
    ],
    "ops": [],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "dimensions.width"
      }
    }
  },
  {
    "name": "whole-number floats are accepted (JS cannot tell 1000.0 from 1000)",
    "base": "two",
    "ops": [
      {
        "op": "add_shelf",
        "compartmentId": "cmp_a",
        "y": 1000.0,
        "id": "shf_2"
      }
    ],
    "expect": {
      "match": {
        "compartments": [
          {
            "shelves": [
              {},
              {
                "y": 1000
              }
            ]
          },
          {}
        ]
      }
    }
  },
  {
    "name": "ops must be an array",
    "base": "two",
    "ops": {
      "op": "remove_component",
      "id": "shf_1"
    },
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops"
      }
    }
  },
  {
