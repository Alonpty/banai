[
  {
    "name": "whitespace-only custom name",
    "base": "two",
    "ops": [
      {
        "op": "set_material",
        "target": "carcass",
        "color": {
          "custom": true,
          "name": "   "
        }
      }
    ],
    "expect": {
      "error": {
        "code": "SCHEMA_INVALID",
        "path": "ops[0]"
      }
    }
  },
  {
